# Training environment for teacher's final-project lab. NOT real bank credentials.
# This exact public sandbox user pair was supplied in the CallMan environment.
# No need to copy to .env for basic testing; IntelliJ 'mvn test' uses identical
# TRAINING-ONLY defaults when QA_API_BASE_URL is exactly https://api.anarabbas.com.
# If you create .env, copy once without overwriting: cp -n env.example .env
# NEVER put real passwords or tokens in Git.
QA_API_BASE_URL=https://api.anarabbas.com

# Automatically POST /auth/login, extract 'token', and add Authorization: Bearer.
# Demo credentials may be changed by the server owner in the future.
QA_USER1_EMAIL=user1@test.com
QA_USER1_PASSWORD=User1234
QA_USER2_EMAIL=user2@test.com
QA_USER2_PASSWORD=User1234

# Optional: supply an existing token if you need to re-use a CallMan sandbox.
# Normally leave these EMPTY to let the Java framework auto-login.
QA_TOKEN_USER1=
QA_TOKEN_USER2=

# Optional scenario fixtures for state-dependent tests.
QA_TEST_IBAN=
QA_CARD_ACCOUNT_ID=acc_002
QA_ACTIVE_CARD_ID=
QA_VALID_SUBSCRIBER_NO=1234567890

# Sandbox lifecycle for JUnit/Gauge in separate processes.
# Reuse token for up to 23h50m (teacher expires tokens after 24h).
# Saved ONLY in .qa-sandbox/ with private file permissions and ignored by Git.
QA_SESSION_PERSIST=true
# Set true for a single fresh run, then remove/disable (or run reset-sandbox.sh).
QA_FRESH_SANDBOX=false
