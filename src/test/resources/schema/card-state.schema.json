{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "id",
    "status",
    "blockReason",
    "blockedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^vcd_"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "FROZEN",
        "BLOCKED"
      ]
    },
    "blockReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
